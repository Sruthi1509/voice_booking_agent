# Groq API key. Server-side only; never expose this value to the browser.
GROQ_API_KEY=your_groq_api_key_here

# Optional model override.
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated list of allowed frontend origins (CORS)
FRONTEND_ORIGINS=http://localhost:3000,https://your-deployed-frontend.vercel.app
